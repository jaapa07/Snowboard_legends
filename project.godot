; Engine configuration file.
config_version=5

[application]

config/name="Snowboard Legends 3D"
config/description="Spiritual successor arcade snowboard racer. Godot 4.4.1."
config/version="1.0.0"
run/main_scene="res://scenes/menus/boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/sprites/ui/icon.png"

boot_splash/bg_color=Color(0.05, 0.09, 0.2, 1)
boot_splash/show_image=false

[autoload]

Registry="*res://scripts/core/registry.gd"
Save="*res://scripts/save/save_service.gd"
Inputs="*res://scripts/core/input_router.gd"
Audio="*res://scripts/core/audio_manager.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/ui/theme.tres"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="GodotPhysics3D"

[input_devices]

pointing/emulate_mouse_from_touch=true
sensors/enable_accelerometer=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="riders"
3d_physics/layer_3="pickups"
3d_physics/layer_4="projectiles"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssao/half_size=true
environment/defaults/default_clear_color=Color(0.35, 0.6, 0.95, 1)
lights_and_shadows/directional_shadow/size=4096
